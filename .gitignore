# ── Node / Yarn ─────────────────────────────────────────────────────────────
node_modules/
.yarn/cache
.yarn/install-state.gz
.pnp.*
*.tgz

# ── Build outputs ──────────────────────────────────────────────────────────
dist/
server/public/
*.tsbuildinfo

# ── Aspire (TypeScript apphost) ─────────────────────────────────────────────
# .modules/ holds the SDK regenerated by `aspire restore` — keep out of git.
.modules/
.aspire/
# `aspire run` invokes its installer resources via npm; they regenerate
# package-lock.json files even though the project uses Yarn 4 berry.
package-lock.json
**/package-lock.json

# ── Env / secrets / runtime state ──────────────────────────────────────────
.env
.env.*
!.env.example
.mango/
*.db
*.db-shm
*.db-wal

# ── Tauri / Rust ───────────────────────────────────────────────────────────
desktop/src-tauri/target/
desktop/src-tauri/gen/
# Permission schemas tauri-build generates from build.rs's command list —
# regenerated every build (CI included), so no need to track them.
desktop/src-tauri/permissions/autogenerated/
desktop/bin/
*.bun-build

# ── .NET ────────────────────────────────────────────────────────────────────
bin/
obj/
.vs/
*.user
*.suo
artifacts/
*.nupkg
*.snupkg
*.csproj.lscache

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# ── Claude Code worktrees ───────────────────────────────────────────────────
.claude/worktrees/
