{
  "name": "@mango/server",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:mongo": "tsx scripts/seed-mongo.ts",
    "compile": "bun build src/index.ts --compile --outfile=../dist-bin/mango-server"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "acorn": "^8.19.0",
    "bson": "^7.3.3",
    "hono": "^4.13.13",
    "mongodb": "^7.7.0",
    "open": "^11.0.4",
    "openai": "^7.30.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
