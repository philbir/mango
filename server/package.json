{
  "name": "@mango/server",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile": "bun build src/index.ts --compile --outfile=../dist-bin/mango-server"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.10",
    "@github/copilot-sdk": "^0.3.0",
    "@hono/node-server": "^1.13.7",
    "bson": "^6.10.0",
    "hono": "^4.6.14",
    "mongodb": "^6.12.0",
    "open": "^11.0.0",
    "openai": "^4.85.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
