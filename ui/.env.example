# Enable OpenTelemetry tracing in the browser. Spans are posted to the
# same-origin proxy at /api/otlp, which the server forwards to the Aspire
# dashboard's OTLP/HTTP endpoint.
#
# Pair with OTEL_EXPORTER_OTLP_ENDPOINT (and optionally
# OTEL_EXPORTER_OTLP_HTTP_ENDPOINT) on the server.
VITE_OTEL_ENABLED=true
# VITE_OTEL_SERVICE_NAME=mango-ui
# VITE_OTEL_COLLECTOR_BASE_URL=/api/otlp
