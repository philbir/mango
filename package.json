{
  "name": "mango",
  "private": true,
  "version": "0.2.0",
  "description": "Mango — a friendly MongoDB workbench. Browser, editor, AI query assistant, and shell. Runs as Aspire extension, Docker container, or desktop app.",
  "homepage": "https://philbir.github.io/mango/",
  "repository": {
    "type": "git",
    "url": "https://github.com/philbir/mango.git"
  },
  "workspaces": [
    "server",
    "ui",
    "docs-site",
    "desktop"
  ],
  "scripts": {
    "dev": "concurrently --names \"server,ui\" --prefix-colors \"blue,magenta\" --kill-others-on-fail \"yarn dev:server\" \"yarn dev:ui\"",
    "dev:server": "yarn workspace @mango/server dev",
    "dev:ui": "yarn workspace @mango/ui dev",
    "build": "yarn workspace @mango/ui build && yarn workspace @mango/server build",
    "start": "yarn workspace @mango/server start",
    "test": "yarn workspace @mango/server test",
    "docs:dev": "yarn workspace @mango/docs-site dev",
    "docs:build": "yarn workspace @mango/docs-site build",
    "docs:preview": "yarn workspace @mango/docs-site preview",
    "aspire": "yarn install && yarn workspace @mango/ui build && yarn workspace @mango/server dev",
    "tauri": "yarn workspace @mango/desktop tauri",
    "tauri:dev": "yarn workspace @mango/desktop dev",
    "tauri:build": "yarn workspace @mango/desktop build",
    "compile-server": "yarn workspace @mango/desktop compile-server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "packageManager": "yarn@4.5.0"
}
