{
  "name": "mango",
  "private": true,
  "type": "module",
  "version": "0.5.0",
  "description": "Mango — a friendly MongoDB workbench. Browser, editor, AI query assistant, and shell. Runs as Aspire extension, Docker container, or desktop app.",
  "homepage": "https://philbir.github.io/mango/",
  "repository": {
    "type": "git",
    "url": "https://github.com/philbir/mango.git"
  },
  "scripts": {
    "dev": "concurrently --names \"server,ui\" --prefix-colors \"blue,magenta\" --kill-others-on-fail \"pnpm dev:server\" \"pnpm dev:ui\"",
    "dev:server": "pnpm --filter @mango/server dev",
    "dev:ui": "pnpm --filter @mango/ui dev",
    "build": "pnpm --filter @mango/ui build && pnpm --filter @mango/server build",
    "start": "pnpm --filter @mango/server start",
    "test": "pnpm --filter @mango/server test",
    "docs:dev": "pnpm --filter @mango/docs-site dev",
    "docs:build": "pnpm --filter @mango/docs-site build",
    "docs:preview": "pnpm --filter @mango/docs-site preview",
    "aspire": "pnpm install && pnpm --filter @mango/ui build && pnpm --filter @mango/server dev",
    "tauri": "pnpm --filter @mango/desktop tauri",
    "tauri:dev": "pnpm --filter @mango/desktop dev",
    "tauri:build": "pnpm --filter @mango/desktop build",
    "compile-server": "pnpm --filter @mango/desktop compile-server",
    "aspire:lint": "eslint apphost.ts",
    "aspire:start": "aspire run",
    "aspire:build": "tsc -p tsconfig.apphost.json",
    "aspire:dev": "tsc --watch -p tsconfig.apphost.json",
    "lint": "pnpm aspire:lint"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "vscode-jsonrpc": "^8.2.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
